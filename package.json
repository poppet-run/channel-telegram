{
  "name": "@poppet/channel-telegram",
  "version": "0.0.0",
  "private": true,
  "description": "Telegram channel for Poppet's messaging gateway.",
  "license": "BSD-3-Clause",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    "./registration": "./src/registration.ts"
  },
  "scripts": {
    "format": "bun ../poppet/node_modules/oxfmt/bin/oxfmt --config ../poppet/oxfmt.config.ts --write .",
    "format:check": "bun ../poppet/node_modules/oxfmt/bin/oxfmt --config ../poppet/oxfmt.config.ts --check .",
    "lint": "bun ../poppet/node_modules/oxlint/bin/oxlint --config ../poppet/oxlint.config.ts .",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "peerDependencies": {
    "@poppet/gateway": "*",
    "effect": "4.0.4"
  },
  "packageManager": "bun@1.4.4"
}
